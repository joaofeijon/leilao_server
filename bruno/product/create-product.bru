meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/product/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Leilao de relogio antigo",
    "name": "Relogio de bolso",
    "description": "Relogio de bolso de 1920, funcionando",
    "initialValue": 15000
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("productId", res.body.product.id);
  }
}
